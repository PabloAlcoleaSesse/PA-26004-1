# Host-side Go commands. Compose uses its own internal database URL.
DATABASE_URL=postgres://music:music@127.0.0.1:5433/music?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
WORKER_CONCURRENCY=4
# Optional Compose host-port overrides. Update DATABASE_URL/HTTP_ADDR to match.
POSTGRES_PORT=5433
API_PORT=8080

# Optional Spotify connection (PKCE does not require a client secret).
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/auth/spotify/callback
# Generate locally with: openssl rand -base64 32
# Keep this key stable and private; never commit the populated .env file.
TOKEN_ENCRYPTION_KEY=

# Optional Apple Music server credentials. Generate a MusicKit user token in
# the client with MusicKit JS or a native MusicKit integration.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
PUBLIC_ORIGIN=http://127.0.0.1:8080
